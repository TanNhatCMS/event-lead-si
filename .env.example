# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — CHỈ dùng phía server (route handler / server action).
# Không bao giờ commit giá trị thật, không đưa ra client, không log.
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway key for the approved card-recognition provider (server only)
AI_GATEWAY_API_KEY=

# Set true only after the AI provider, data region, retention, and consent are approved.
CARD_RECOGNITION_ENABLED=false

# Model dùng cho agent làm giàu dữ liệu danh thiếp (lead enrichment) qua AI Gateway (server only).
# Ví dụ: "anthropic/claude-sonnet-4-5". Nếu tổ chức đã cấu hình capability
# `lead_enrichment` trong bảng ai_model_configs (migration của PR #10) thì cấu hình DB được ưu tiên.
ENRICHMENT_MODEL=

# Khóa API cho provider tìm kiếm web của agent làm giàu dữ liệu (server only, tùy chọn).
# TODO: provider tìm kiếm web chưa được chốt — tool web_search hiện báo chưa khả dụng
# cho đến khi provider được chọn và triển khai gọi API thật tại tools.ts.
SEARCH_API_KEY=

# Model cho trợ lý sourcing Phase 3 (gợi ý ứng viên, soạn RFQ/đàm phán,
# soạn tin nhắn giới thiệu) qua AI Gateway (server only).
# Nếu đã cấu hình capability `sourcing_assist` trong bảng ai_model_configs
# (trang Mô hình AI) thì cấu hình DB được ưu tiên.
SOURCING_MODEL=

# Model soạn nháp tin nhắn follow-up qua AI Gateway (server only).
# Nếu đã cấu hình capability `followup_draft` trong bảng ai_model_configs
# (trang Mô hình AI) thì cấu hình DB được ưu tiên.
FOLLOWUP_MODEL=

# Model chat cho trợ lý RAG (/home/tro-ly) qua AI Gateway (server only).
# Nếu đã cấu hình capability `rag_chat` trong bảng ai_model_configs
# (trang Cài đặt → Mô hình AI) thì cấu hình DB được ưu tiên.
RAG_CHAT_MODEL=

# Model embedding cho RAG (server only). Mặc định: openai/text-embedding-3-small.
RAG_EMBEDDING_MODEL=

# Provider nhận dạng danh thiếp: mock | gateway (server only). Mặc định: mock.
CARD_RECOGNITION_PROVIDER=
# Model nhận dạng danh thiếp qua AI Gateway khi CARD_RECOGNITION_PROVIDER=gateway.
CARD_RECOGNITION_MODEL=

# Backend tìm kiếm web cho agent làm giàu dữ liệu (server only):
# tool = POST tới tool tự dựng (SEARCH_TOOL_URL + SEARCH_TOOL_KEY),
# api = API thương mại (Tavily/Serper/Brave qua SEARCH_API_URL + SEARCH_API_KEY),
# fetch = parse HTML DuckDuckGo (không cần key),
# none = tắt tìm kiếm web.
SEARCH_PROVIDER=none
# URL + key cho SEARCH_PROVIDER=api (server only).
SEARCH_API_URL=
# Tên header gửi API key cho SEARCH_PROVIDER=api. Mặc định: X-API-KEY.
SEARCH_API_KEY_HEADER=
# URL + key cho SEARCH_PROVIDER=tool (server only).
SEARCH_TOOL_URL=
SEARCH_TOOL_KEY=

# Danh sách domain cho phép/chặn của tool web_fetch (phân cách bằng dấu phẩy,
# server only). Blocklist luôn được ưu tiên hơn allowlist; IP nội bộ và
# cloud metadata luôn bị chặn bất kể cấu hình.
WEBFETCH_ALLOWLIST=
WEBFETCH_BLOCKLIST=
