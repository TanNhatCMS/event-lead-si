# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — CHỈ dùng phía server (route handler / server action).
# Không bao giờ commit giá trị thật, không đưa ra client, không log.
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway key for the approved card-recognition provider (server only)
AI_GATEWAY_API_KEY=

# Set true only after the AI provider, data region, retention, and consent are approved.
CARD_RECOGNITION_ENABLED=false
