# Copy file này thành apps/web/.env.docker rồi điền giá trị thật.
# File .env.docker được docker-compose.yml load lúc runtime (server-only vars).
# Các biến NEXT_PUBLIC_* phải set lúc BUILD (build args / env khi chạy
# docker compose build) — không đọc từ file này.

# Supabase service-role key — server only.
# Với Supabase local, giá trị mặc định của supabase CLI (compose đã có default):
# SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway key cho nhận dạng danh thiếp (server only) — bỏ trống khi test
# local để dùng provider mock.
AI_GATEWAY_API_KEY=

# Set true chỉ sau khi AI provider / data region / consent được duyệt.
CARD_RECOGNITION_ENABLED=false

# Provider nhận dạng danh thiếp: mock | gateway (mặc định: mock).
CARD_RECOGNITION_PROVIDER=mock

# Model làm giàu dữ liệu / sourcing / follow-up / RAG (server only, tùy chọn).
ENRICHMENT_MODEL=
SOURCING_MODEL=
FOLLOWUP_MODEL=
RAG_CHAT_MODEL=
RAG_EMBEDDING_MODEL=

# Tìm kiếm web cho agent enrichment: none | fetch | api | tool.
SEARCH_PROVIDER=none
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_API_KEY_HEADER=
SEARCH_TOOL_URL=
SEARCH_TOOL_KEY=
WEBFETCH_ALLOWLIST=
WEBFETCH_BLOCKLIST=
