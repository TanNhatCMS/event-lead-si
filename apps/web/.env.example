# ============================================================================
# EventLead — biến môi trường mẫu. Copy thành .env.local (dev) hoặc cấu hình
# trên nền running (Docker: apps/web/.env.docker). KHÔNG commit key thật.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Local supabase start: xem `supabase status`. Production: project URL + keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Gateway (một key cho mọi nhà cung cấp — không bắt buộc) -------------
# Cấu hình model theo capability ở /admin/settings; chỉ cần key khi chọn
# provider "AI Gateway" hoặc "Vision".
AI_GATEWAY_API_KEY=

# --- OpenAI trực tiếp (không bắt buộc) --------------------------------------
# Cần khi provider cấu hình là "OpenAI (trực tiếp)" hoặc "openai-compatible"
# (openai-compatible còn cần base_url trong config capability).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Model mặc định theo env (fallback khi user chưa cấu hình ở /admin/settings)
ENRICHMENT_MODEL=
RAG_CHAT_MODEL=openai/gpt-4o-mini
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Nhận dạng danh thiếp ---------------------------------------------------
# mock = dữ liệu mẫu; vision = model AI qua AI Gateway (cần key + model đọc ảnh)
CARD_RECOGNITION_PROVIDER=mock
CARD_RECOGNITION_MODEL=

# --- Web search cho agent (SEARCH_PROVIDER) ---------------------------------
# tool     : SEARCH_TOOL_URL — POST {query, maxResults} tự dựng
# api      : SEARCH_API_URL — POST {query, max_results, q} (Tavily/Serper/Brave…)
#            SEARCH_API_KEY + SEARCH_API_KEY_HEADER (mặc định X-API-KEY)
# tinyfish : TinyFish Search API — chỉ cần TINYFISH_API_KEY (miễn phí)
# fetch    : DuckDuckGo HTML, không cần key (best-effort)
SEARCH_PROVIDER=
SEARCH_TOOL_URL=
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_API_KEY_HEADER=X-API-KEY
TINYFISH_API_KEY=

# --- Web fetch cho agent (WEBFETCH_PROVIDER) --------------------------------
# direct  : fetch trực tiếp (mặc định)
# tinyfish: TinyFish Fetch API — markdown sạch, qua được trang chặn bot
#           thường; cần TINYFISH_API_KEY
WEBFETCH_PROVIDER=
