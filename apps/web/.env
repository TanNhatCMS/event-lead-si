# SHARED ENVIROMENT VARIABLES
# HERE YOU CAN ADD ALL THE **PUBLIC** ENVIRONMENT VARIABLES THAT ARE SHARED ACROSS ALL THE ENVIROMENTS
# PLEASE DO NOT ADD ANY CONFIDENTIAL KEYS OR SENSITIVE INFORMATION HERE
# ONLY CONFIGURATION, PATH, FEATURE FLAGS, ETC.
# TO OVERRIDE THESE VARIABLES IN A SPECIFIC ENVIRONMENT, PLEASE ADD THEM TO THE SPECIFIC ENVIRONMENT FILE (e.g. .env.development, .env.production)

# SITE
# Lưu ý: title/description của metadata không còn đọc từ đây nữa — chúng nằm
# trong i18n/messages/{locale}/marketing.json (keys metaTitle, metaDescription).
# Các biến dưới đây vẫn được schema app.config.ts yêu cầu và dùng cho
# applicationName / tên sản phẩm (vd: heading đăng nhập, copyright footer).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=EventLead
NEXT_PUBLIC_SITE_TITLE="EventLead — Quản lý khách hàng tiềm năng tại sự kiện"
NEXT_PUBLIC_SITE_DESCRIPTION="EventLead quét danh thiếp, quản lý danh bạ và dùng AI làm giàu dữ liệu khách hàng tiềm năng sau sự kiện."
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#ffffff"
NEXT_PUBLIC_THEME_COLOR_DARK="#0a0a0a"

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# LOCALES PATH
NEXT_PUBLIC_LOCALES_PATH=apps/web/i18n/messages

# FEATURE FLAGS
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true
NEXT_PUBLIC_LANGUAGE_PRIORITY=application
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=true